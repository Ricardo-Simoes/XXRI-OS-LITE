## SECTION=project_specific

config XXRI_XLIBRE_INPUT_LIBINPUT
	bool
	select XXRI_XLIBRE
	select HOST_MESON
	prompt "xxri-xlibre-input-libinput: libinput input driver for XLibre"
	help
	  XLibre's xf86-input-libinput, built against xxri-xlibre's module
	  ABI and Tiny Core's libinput (X.Org's driver modules do not load
	  into XLibre).
