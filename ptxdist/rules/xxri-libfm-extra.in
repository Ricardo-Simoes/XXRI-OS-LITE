## SECTION=project_specific

config XXRI_LIBFM_EXTRA
	bool
	select XXRI_TC_SYSROOT
	select HOST_INTLTOOL
	select HOST_PERL_XML_PARSER
	prompt "xxri-libfm-extra: libfm-extra (build step)"
	help
	  libfm 1.3.2 configured --with-extra-only: the small library
	  menu-cache needs before the full libfm can be built against
	  menu-cache.  Installs nothing into the image (xxri-libfm does).
