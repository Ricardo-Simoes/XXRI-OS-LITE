## SECTION=project_specific

config XXRI_LIBFM
	bool
	select XXRI_TC_SYSROOT
	select XXRI_LIBEXIF
	select XXRI_MENU_CACHE
	select HOST_INTLTOOL
	select HOST_PERL_XML_PARSER
	prompt "xxri-libfm: libfm 1.3.2 (GTK 3) for XXRI File"
	help
	  libfm, libfm-gtk3 and libfm-extra 1.3.2 with the GTK 3 front end
	  (Tiny Core 16's libfm is GTK 2), their data files and the six
	  modules 2.6 shipped.
