+#undef TITLE_FONT
+#endif
+#define TITLE_FONT "-xxri-helvetica-bold-r-normal--*"
+#define XXRI_TITLE_H    26
+#undef  LEFT
+#define LEFT   3
+#undef  RIGHT
+#define RIGHT  3
+#undef  TOP
+#define TOP    0
+#undef  BOTTOM
+#define BOTTOM 4
+
+// The control cluster: hit area per control, inset before the first one, and
