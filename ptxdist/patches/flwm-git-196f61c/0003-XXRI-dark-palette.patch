--- a/main.C
+++ b/main.C
@@ -415,6 +415,21 @@
 }
 
 #ifdef XXRI
+// the desktop menu's colours; Fl::background recomputes the gray ramp boxes use
+static void xxri_menu_colors() {
+  Fl::background((XXRI_MENU_BG>>16)&0xff, (XXRI_MENU_BG>>8)&0xff, XXRI_MENU_BG&0xff);
+  Fl::background2((XXRI_BAR_ACTIVE>>16)&0xff, (XXRI_BAR_ACTIVE>>8)&0xff, XXRI_BAR_ACTIVE&0xff);
+  Fl::foreground((XXRI_INK>>16)&0xff, (XXRI_INK>>8)&0xff, XXRI_INK&0xff);
+}
+// Settings switches Light/Dark while windows are open: look at the mode file
+// now and then (a stat-sized read), and repaint every frame when it changed
+static void xxri_watch_palette(void*) {
+  if (xxri_palette_load()) {
+    xxri_menu_colors();
+    for (Frame* c = Frame::first; c; c = c->next) c->redraw();
+  }
+  Fl::repeat_timeout(2.0, xxri_watch_palette);
+}
 // A flat popup frame: fill plus a single hairline border.
 static void xxri_menu_frame(int x, int y, int w, int h, Fl_Color) {
   fl_color(fl_rgb_color((XXRI_MENU_BORDER>>16)&0xff,
@@ -490,10 +505,10 @@
