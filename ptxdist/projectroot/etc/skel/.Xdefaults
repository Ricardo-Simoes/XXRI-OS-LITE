! xxri OS Lite design system - X resources
! Palette: surface #F5F5F7 / card #FFFFFF / ink #1C1C1E
!          accent #2E7CF6 (blue); neutral greys, no tinted whites

! ---- FLTK applications (dialogs, editor, mount tool, popups) ----
! FLTK only reads the "fltk" class from Fl::get_system_colors(), which not
! every app calls, so the per-application classes are listed too.
editor*background: #F5F5F7
editor*foreground: #1C1C1E
mnttool*background: #F5F5F7
mnttool*foreground: #1C1C1E
fltk*background: #F5F5F7
fltk*foreground: #1C1C1E
fltk*scheme: gtk+
Text*background: #FFFFFF
Text*foreground: #1C1C1E
Text*selectBackground: #2E7CF6
Text*selectForeground: #FFFFFF
Xft.dpi: 96.0

! ---- Terminal (aterm): dark glass panel from the design language ----
! This aterm build ignores scrollColor/scrollstyle and always draws rxvt's
! dithered grey trough, which is the only grey left on the desktop.  Hide it:
! Shift+PageUp / Shift+PageDown still walk the 2000-line scrollback.
Aterm*scrollBar: false
! solid #242124, the palette's terminal panel; no pseudo-transparency
Aterm*transparent: false
Aterm*title: XXRI Terminal
Aterm*font: 9x15
Aterm*boldFont: 9x15bold
Aterm*saveLines: 2000
Aterm*foreground: #F2F2F4
Aterm*background: #242124
Aterm*shading: 35
Aterm*tinting: #242124
Aterm*fading: 70
Aterm*cursorColor: #4C93F8
Aterm*pointerColor: #A0A1AA
Aterm*borderColor: #242124
! xxri terminal palette (normal 0-7 / bright 8-15)
Aterm*color0: #242124
Aterm*color1: #F25E86
Aterm*color2: #3FBF8F
Aterm*color3: #F2A65E
Aterm*color4: #2E7CF6
Aterm*color5: #ED6CE0
Aterm*color6: #46C8E0
Aterm*color7: #E6E6EA
Aterm*color8: #5A5B66
Aterm*color9: #FF7FA0
Aterm*color10: #5BDCA9
Aterm*color11: #FFC07E
Aterm*color12: #6FA5FF
Aterm*color13: #F792EC
Aterm*color14: #6FDFF2
Aterm*color15: #FFFFFF
