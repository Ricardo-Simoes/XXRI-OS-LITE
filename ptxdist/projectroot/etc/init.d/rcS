#!/bin/sh
# RC Script for xxri OS Lite
# (c) Robert Shingledecker 2004-2012

# Mount /proc.
[ -f /proc/cmdline ] || /bin/mount /proc

# Remount rootfs rw.
/bin/mount -o remount,rw /

# Mount system devices from /etc/fstab.
/bin/mount -a

# xxri OS Lite boot splash (Phase 8.3): on graphical boots, cover every Tiny
# Core boot message with the native framebuffer splash until X comes up.  It
# self-exits when the X server socket appears (or after a safety timeout) and
# never blocks boot.  Gated to desktop boots (installed root has Xserver set;
# the live desktop ISO passes the `cde` boot code); skipped for text/cli boots.
if [ -x /usr/local/sbin/xxri-bootsplash ] && \
   ! grep -qwE 'text|nox|xonly|noquiet' /proc/cmdline && \
   { [ -s /etc/sysconfig/Xserver ] || grep -qw cde /proc/cmdline; }; then
	/usr/local/sbin/xxri-bootsplash >/dev/null 2>&1 &
fi

clear

# Call the upstream Tiny Core entry point, a symlink to xxri-config.  Boot
# tools patch tc-config by that name - Ventoy's Tiny Core hook seds in the
# code that maps the ISO file as a disk (without it, cde is never found and
# the desktop never starts) - and sed -i replaces the symlink with the
# patched copy, so calling xxri-config directly would bypass their patch.
/etc/init.d/tc-config >/dev/null 2>&1

