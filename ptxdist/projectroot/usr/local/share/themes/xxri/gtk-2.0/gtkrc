# xxri OS Lite - GTK2 theme
# Palette from the official design language: a white ground, neutral grey
# surfaces (#F5F5F7, #ECECEF), ink #1C1C1E, accent blue #2E7CF6.

gtk-font-name = "Avenir Next 10"
gtk-icon-theme-name = "xxri"
gtk-cursor-theme-name = "xxri-cursors"

style "xxri-default" {
  bg[NORMAL]        = "#F5F5F7"
  bg[PRELIGHT]      = "#ECECEF"
  bg[ACTIVE]        = "#E2E2E6"
  bg[INSENSITIVE]   = "#F5F5F7"
  bg[SELECTED]      = "#2E7CF6"

  fg[NORMAL]        = "#1C1C1E"
  fg[PRELIGHT]      = "#1C1C1E"
  fg[ACTIVE]        = "#1C1C1E"
  fg[INSENSITIVE]   = "#9A9AA2"
  fg[SELECTED]      = "#FFFFFF"

  base[NORMAL]      = "#FFFFFF"
  base[PRELIGHT]    = "#F5F5F7"
  base[ACTIVE]      = "#E2E2E6"
  base[INSENSITIVE] = "#F5F5F7"
  base[SELECTED]    = "#2E7CF6"

  text[NORMAL]      = "#1C1C1E"
  text[PRELIGHT]    = "#1C1C1E"
  text[ACTIVE]      = "#1C1C1E"
  text[INSENSITIVE] = "#9A9AA2"
  text[SELECTED]    = "#FFFFFF"

  GtkButton::default_border = { 0, 0, 0, 0 }
  GtkRange::trough_border = 0
  GtkWidget::focus_line_width = 1
  GtkMenu::horizontal-padding = 6
  GtkMenu::vertical-padding = 6
}

style "xxri-menu" = "xxri-default" {
  bg[NORMAL] = "#FFFFFF"
  bg[PRELIGHT] = "#ECECEF"
  fg[PRELIGHT] = "#1C1C1E"
  xthickness = 8
  ythickness = 6
}

style "xxri-tooltip" = "xxri-default" {
  bg[NORMAL] = "#1C1C1E"
  fg[NORMAL] = "#F2F2F4"
}

class "GtkWidget" style "xxri-default"
widget_class "*<GtkMenu>*" style "xxri-menu"
widget "gtk-tooltip*" style "xxri-tooltip"
