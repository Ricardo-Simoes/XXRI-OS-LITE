#!/bin/sh
# xxri-dock-launch KEY COMMAND [ARGS...] - what every dock icon runs.
#
# If the app already has a window, raise (and deiconify) it instead of
# starting another copy. KEY is the WM_CLASS instance (see xxri-wctl).
# "+name": always start a new one (terminals), still shows the running dot.
# "-": not an app at all (the power menu).
set -u
KEY="${1:?usage: xxri-dock-launch KEY COMMAND [ARGS...]}"
shift
[ $# -gt 0 ] || exit 2

case "$KEY" in
	-*|+*) exec "$@" ;;    # never reuse a window: not an app, or multi-instance
esac

if [ -x /usr/local/bin/xxri-wctl ]; then
	if /usr/local/bin/xxri-wctl activate "$KEY" 2>/dev/null; then
		exit 0
	fi
fi
exec "$@"
