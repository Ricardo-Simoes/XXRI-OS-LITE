#!/bin/sh
# xxri-dock-pin - pin/unpin applications on the XXRI dock's PINNED area.
#
# pinned.list (/usr/local/share/xxri-launcher) is the source of truth: one
# .desktop id per line, dock order, max 8. Only this script writes it and
# turns it into the live dock (/usr/local/tce.icons, what wbar reads).
# Icons, names and commands come fresh from the .desktop files each time,
# the same ones the All Apps drawer reads.
#
#   xxri-dock-pin pin ID       add ID (no-op if already pinned or dock is full)
#   xxri-dock-pin unpin ID     remove ID (no-op if not pinned)
#   xxri-dock-pin list         print pinned ids, one per line, in dock order
#   xxri-dock-pin count        print how many are pinned
#   xxri-dock-pin regen        rebuild tce.icons AND restart the live dock
#   xxri-dock-pin boot         rebuild tce.icons only (wbar_setup.sh; the
#                              session starts wbar right after)
#   xxri-dock-pin watch        keep the dock's running section in step with
#                              the open windows (started by .xsession)
#
# The dock is one pill: running-but-unpinned apps get entries after the
# pinned ones, behind a separator. Nothing running = just the pinned icons.
set -u
APPDIR="${XXRI_APPDIR:-/usr/local/share/applications}"
PINNED="${XXRI_PINNED:-/usr/local/share/xxri-launcher/pinned.list}"
DOTWBAR="${XXRI_DOTWBAR:-/usr/local/share/wbar/dot.wbar}"
TCEWBAR="${XXRI_TCEWBAR:-/usr/local/tce.icons}"
SUDO="${XXRI_DOCK_PIN_SUDO-sudo}"
REG_DIR="${XXRI_REGDIR:-/usr/local/share/xxri-apps}"
WCTL="${XXRI_WCTL:-/usr/local/bin/xxri-wctl}"
MAXPIN=8
# '|', not tab: tab is IFS whitespace, so `read` drops an empty field (an
# unmatched window has an empty first field) and shifts the rest
SEP='|'

# shared by the user and root: if we can't append, log to /dev/null - a failed
# redirection skips the whole command (that broke the icon framer once)
LOG=/tmp/xxri-dock-pin.log
{ : >> "$LOG"; } 2>/dev/null || LOG=/dev/null
log() { echo "[$(date '+%H:%M:%S')] xxri-dock-pin: $*" >> "$LOG"; }

ensure_pinned_file() {
	[ -f "$PINNED" ] || $SUDO sh -c ": > '$PINNED'"
	# chmod after every write: BusyBox cp copies the source's mode, mktemp
	# files are 0600, and a 0600 pinned.list is unreadable to the user doing
	# the pin - pinned_ids() returns nothing and the next regen empties the dock
	$SUDO chmod 644 "$PINNED" 2>/dev/null
}

put_pinned() { # srcfile
	$SUDO cp "$1" "$PINNED"
	$SUDO chmod 644 "$PINNED"
}

pinned_ids() { grep -v '^[[:space:]]*#' "$PINNED" 2>/dev/null | grep -v '^[[:space:]]*$'; }

is_pinned() { # id -> 0 if pinned
	pinned_ids | grep -qx "$1"
}

# [Desktop Entry] group only, like xxri-launcher's scanner (no action groups)
desktop_field() { # file key
	awk -v k="$1" '
		/^\[Desktop Entry\]/ { ing=1; next }
		/^\[/ { ing=0 }
		ing && $0 ~ "^" k "=" { sub("^" k "=", ""); print; exit }
	' "$2" 2>/dev/null
}

# the dock passes no documents, so drop %U %f ... (else the app gets "%U")
strip_field_codes() {
	echo "$1" | sed -E 's/%[UfFiIcCkKdDnNvm]//g; s/%%/%/g; s/[[:space:]]+$//; s/^[[:space:]]+//'
}

# xxri-dock-launch's focus key. X-XXRI-DockKey wins verbatim (the editor,
# Power); otherwise from Exec's first word. Keep in sync with
# focus_key_for() in xxri-launcher.
dock_key_for() { # exec override
	if [ -n "$2" ]; then echo "$2"; return; fi
	base=$(basename "$(echo "$1" | awk '{print $1}')")
	case "$base" in
		aterm|xterm|xxri-app) echo "+$base" ;;
		*)                    echo "$base" ;;
	esac
}

# xxri-launcher's resolve_icon() without the slow icon theme lookup
resolve_icon() { # full icon
	if [ -n "$1" ] && [ -f "$1" ]; then echo "$1"; return; fi
	if [ -n "$2" ]; then
		case "$2" in
			/*) [ -f "$2" ] && { echo "$2"; return; } ;;
		esac
		for ext in png svg xpm; do
			[ -f "/usr/local/share/pixmaps/$2.$ext" ] && { echo "/usr/local/share/pixmaps/$2.$ext"; return; }
		done
	fi
	echo "/usr/local/share/pixmaps/xxri-app-generic.png"
}

# ---------------------------------------------------------------- matching --
#
# Window -> .desktop entry. WM_CLASS alone can't do it (Code-OSS, launched as
# `xxri-app launch code-oss`, calls itself "code"), so:
#
#   1. by process: the window's _NET_WM_PID -> /proc/PID/exe, matched against
#      the registry entry's FILE or LOCATION (launcher scripts sit beside the
#      real binary); inside an AppImage, $APPIMAGE from its environment
#   2. by name, only without a usable pid: StartupWMClass, X-XXRI-DockKey,
#      the entry id, the registry id and the binary's basename
#
# A fixed per-process path, not mktemp: it's read back in subshells, where a
# mktemp name would be lost and never cleaned up. $$ is the same in them.
IDX="${TMPDIR:-/tmp}/.xxri-dock-index.$$"

reg_field() { # id key
	[ -n "$1" ] || return 0
	[ -f "$REG_DIR/$1.reg" ] && sed -n "s/^$2=//p" "$REG_DIR/$1.reg" | head -1
}

# one line per .desktop: id|names|executables|dirs. One awk pass, this runs
# on every dock rebuild.
build_index() {
	awk '
		function emit() { if (id != "") printf "%s|%s|%s|%s\n", id, ex, swc, ovr }
		FNR==1 { emit(); id=FILENAME; sub(/.*\//,"",id); sub(/\.desktop$/,"",id)
		         ex=""; swc=""; ovr=""; ing=0 }
		/^\[Desktop Entry\]/ { ing=1; next }
		/^\[/                 { ing=0 }
		ing && /^Exec=/           && ex==""  { sub(/^Exec=/,"");           ex=$0 }
		ing && /^StartupWMClass=/ && swc=="" { sub(/^StartupWMClass=/,""); swc=$0 }
		ing && /^X-XXRI-DockKey=/ && ovr=="" { sub(/^X-XXRI-DockKey=/,""); ovr=$0 }
		END { emit() }
	' "$APPDIR"/*.desktop 2>/dev/null | while IFS="$SEP" read -r id ex swc ovr; do
		[ -n "$id" ] || continue
		ex=$(strip_field_codes "$ex")
		first=${ex%% *}; base=${first##*/}
		toks="$id"
		case "$id" in xxri-app-*) toks="$toks ${id#xxri-app-}" ;; esac
		[ -n "$swc" ] && toks="$toks $swc"
		[ -n "$ovr" ] && toks="$toks ${ovr#[-+]}"
		exes=""; dirs=""
		if [ "$base" = xxri-app ]; then
			# `xxri-app launch ID`: every Store app shares the wrapper,
			# the registry entry is the identity
			rid=$(echo "$ex" | awk '{print $3}')
			[ -n "$rid" ] && toks="$toks $rid"
			exes=$(reg_field "$rid" FILE)
			dirs=$(reg_field "$rid" LOCATION)
		else
			toks="$toks $base"
			case "$first" in
				/*) exes="$first" ;;
				*)  exes=$(command -v "$first" 2>/dev/null) ;;
			esac
		fi
		printf '%s|%s|%s|%s\n' "$id" "$(echo "$toks" | tr 'A-Z' 'a-z')" "$exes" "$dirs"
	done > "$IDX"
}

resolve_window() { # instance pid -> .desktop id, or nothing
	_inst=$(echo "$1" | tr 'A-Z' 'a-z'); _pid="$2"
	[ "$_inst" = "-" ] && _inst=""
	if [ -n "$_pid" ] && [ "$_pid" != 0 ] && [ -d "/proc/$_pid" ]; then
		_exe=$(readlink "/proc/$_pid/exe" 2>/dev/null)
		_img=$(tr '\0' '\n' < "/proc/$_pid/environ" 2>/dev/null | sed -n 's/^APPIMAGE=//p' | head -1)
		# from a file, not a pipe: a piped `while` is a subshell and the
		# `return` would only leave the loop
		while IFS="$SEP" read -r _id _toks _exes _dirs; do
			for _e in $_exes; do
				[ -n "$_exe" ] && [ "$_exe" = "$_e" ] && { echo "$_id"; return 0; }
				[ -n "$_img" ] && [ "$_img" = "$_e" ] && { echo "$_id"; return 0; }
			done
			[ -n "$_exe" ] || continue
			for _d in $_dirs; do
				case "$_exe" in "$_d"/*) echo "$_id"; return 0 ;; esac
			done
		done < "$IDX"
	fi
	[ -n "$_inst" ] || return 1
	# exact names first, for every entry, before the prefix rule
	while IFS="$SEP" read -r _id _toks _exes _dirs; do
		for _t in $_toks; do
			[ "$_inst" = "$_t" ] && { echo "$_id"; return 0; }
		done
	done < "$IDX"
	# "code" for "code-oss", only on a separator ("codeblocks" doesn't match)
	while IFS="$SEP" read -r _id _toks _exes _dirs; do
		for _t in $_toks; do
			case "$_t" in "$_inst"-*|"$_inst"_*|"$_inst".*) echo "$_id"; return 0 ;; esac
		done
	done < "$IDX"
	return 1
}

# running but unpinned apps as "id|instance" (empty id: no .desktop matched),
# in window order, so new ones land at the end
running_entries() {
	[ -n "${DISPLAY:-}" ] || return 0
	[ -x "$WCTL" ] || return 0
	build_index
	_pins=" $(pinned_ids | tr '\n' ' ') "
	"$WCTL" list 2>/dev/null | {
		_seen=" "
		while read -r _win _state _inst _pid _rest; do
			[ -n "$_inst" ] && [ "$_inst" != "-" ] || continue
			_id=$(resolve_window "$_inst" "$_pid")
			# a pinned application already has its icon in the dock
			case "$_id" in "") ;; *) case "$_pins" in *" $_id "*) continue ;; esac ;; esac
			_mark=${_id:-@$_inst}
			case "$_seen" in *" $_mark "*) continue ;; esac
			_seen="$_seen$_mark "
			printf '%s|%s\n' "$_id" "$_inst"
		done
	}
}

# wbar only draws PNGs from a path, so icons are framed in the XXRI container
# here (xxri-launcher --frame-icon) and cached; tce.icons points at the cache.
# 64px: the size of the shipped pixmaps, wbar scales down from it.
FRAMED="${XXRI_FRAMED:-/usr/local/share/xxri-launcher/framed}"
FRAMER="${XXRI_FRAMER:-/usr/local/bin/xxri-launcher}"
FRAME_PX=64

frame_icon() { # id srcpath -> path to use in tce.icons (framed, or src on failure)
	[ -x "$FRAMER" ] || { echo "$2"; return; }
	$SUDO mkdir -p "$FRAMED" 2>/dev/null
	$SUDO chmod 755 "$FRAMED" 2>/dev/null
	out="$FRAMED/$1.png"
	# cached copy newer than the source is good (no -nt = just redraw)
	if [ -s "$out" ] && [ "$out" -nt "$2" ] 2>/dev/null; then echo "$out"; return; fi
	if $SUDO "$FRAMER" --frame-icon "$2" "$out" "$FRAME_PX" 2>>"$LOG"; then
		# same mode trap as pinned.list: wbar can't draw a 0600 icon
		$SUDO chmod 644 "$out" 2>/dev/null
		echo "$out"
	else
		log "frame_icon $1: --frame-icon failed on $2 - using the raw icon"
		echo "$2"
	fi
}

# The pinned/running separator is drawn into the dock background (a separator
# entry would take a whole icon slot). The geometry is in
# `xxri-launcher --dock-bg`; this passes where the pinned part ends and the
# total slot count.
# dot.wbar's pill, or its -dark twin when Settings' Mode is Dark
# (tools/icons/dock-bg-dark.sh makes it)
dock_base() {
	_b=$(awk '/^i: / { sub(/^i: /,""); print; exit }' "$DOTWBAR")
	_m=$(sed -n 's/^APPEARANCE=//p' "${XXRI_CFG_DIR:-/usr/local/etc/xxri}/desktop.conf" 2>/dev/null | head -1)
	if [ "$_m" = dark ] && [ -f "${_b%.png}-dark.png" ]; then echo "${_b%.png}-dark.png"; else echo "$_b"; fi
}
dock_bg() { # pinned_count total_slots -> background to use, or nothing
	[ -x "$FRAMER" ] || return 1
	base=$(dock_base)
	[ -n "$base" ] && [ -f "$base" ] || return 1
	$SUDO mkdir -p "$FRAMED" 2>/dev/null
	$SUDO chmod 755 "$FRAMED" 2>/dev/null
	out="$FRAMED/dockbg.png"
	$SUDO "$FRAMER" --dock-bg "$base" "$out" "$1" "$2" "$(dock_isize)" 2>>"$LOG" || return 1
	$SUDO chmod 644 "$out" 2>/dev/null
	echo "$out"
}

# DOCK_SIZE from Settings (32..56), else dot.wbar's -isize
dock_isize() {
	_ds=$(sed -n 's/^DOCK_SIZE=\([0-9]*\)$/\1/p' /usr/local/etc/xxri/desktop.conf 2>/dev/null | head -1)
	case "$_ds" in 3[2-9]|4[0-9]|5[0-6]) echo "$_ds"; return ;; esac
	sed -n 's/^c: wbar .*-isize \([0-9]*\).*/\1/p' "$DOTWBAR" | head -1
}

# Rebuild tce.icons: wbar's header triple, then the pinned ids, then the
# running apps. Built in a temp file so nobody reads a half-written one.
write_dock() {
	ensure_pinned_file
	# counts first: the header's background depends on them (separator)
	runlist=$(running_entries)
	r=$(printf '%s\n' "$runlist" | grep -c "$SEP")
	pn=0
	for _id in $(pinned_ids); do
		[ "$pn" -lt "$MAXPIN" ] || break
		[ -f "$APPDIR/$_id.desktop" ] || continue
		pn=$((pn + 1))
	done

	tmp=$(mktemp)
	awk '
		/^i: / && !seen { print; getline t; print t; getline c; print c; seen=1 }
	' "$DOTWBAR" > "$tmp"
	if [ ! -s "$tmp" ]; then
		log "!! could not read wbar header from $DOTWBAR - dock would be empty, aborting"
		rm -f "$tmp"
		return 1
	fi
	_is=$(dock_isize)
	[ -n "$_is" ] && sed -i "3s/-isize [0-9]*/-isize $_is/" "$tmp"
	# nothing unpinned running: no separator, the plain pill
	bg=""
	[ "$r" -gt 0 ] && bg=$(dock_bg "$pn" "$((pn + r))")
	[ -n "$bg" ] || bg=$(dock_base)
	[ -n "$bg" ] && sed -i "1s|^i: .*|i: $bg|" "$tmp"
	n=0
	while IFS= read -r id; do
		[ -n "$id" ] || continue
		n=$((n + 1))
		[ "$n" -le "$MAXPIN" ] || { log "pinned.list has more than $MAXPIN entries - ignoring '$id'"; continue; }
		dsk="$APPDIR/$id.desktop"
		if [ ! -f "$dsk" ]; then
			log "pinned id '$id' has no $dsk any more - dropping it from the dock"
			continue
		fi
		name=$(desktop_field Name "$dsk"); [ -n "$name" ] || name="$id"
		exec_raw=$(desktop_field Exec "$dsk")
		exec_clean=$(strip_field_codes "$exec_raw")
		override=$(desktop_field X-XXRI-DockKey "$dsk")
		key=$(dock_key_for "$exec_clean" "$override")
		icon=$(resolve_icon "$(desktop_field X-FullPathIcon "$dsk")" "$(desktop_field Icon "$dsk")")
		icon=$(frame_icon "$id" "$icon")
		printf 'i: %s\nt: %s\nc: exec /usr/local/bin/xxri-dock-launch %s %s\n' \
			"$icon" "$name" "$key" "$exec_clean" >> "$tmp"
	done <<EOF_LIST
$(pinned_ids)
EOF_LIST
	# ---- the running section: plain entries in the same file
	while IFS="$SEP" read -r rid rinst; do
		[ -n "$rinst" ] || continue
		rdsk="$APPDIR/$rid.desktop"
		if [ -n "$rid" ] && [ -f "$rdsk" ]; then
			rname=$(desktop_field Name "$rdsk"); [ -n "$rname" ] || rname="$rid"
			rexec=$(strip_field_codes "$(desktop_field Exec "$rdsk")")
			ricon=$(resolve_icon "$(desktop_field X-FullPathIcon "$rdsk")" "$(desktop_field Icon "$rdsk")")
			ricon=$(frame_icon "$rid" "$ricon")
		else
			# no .desktop: generic icon, a click only raises it
			rname="$rinst"
			rexec="true"
			ricon=$(frame_icon "run-$rinst" "/usr/local/share/pixmaps/xxri-app-generic.png")
		fi
		# keyed on the window's own WM_CLASS, so a click raises it
		printf 'i: %s\nt: %s\nc: exec /usr/local/bin/xxri-dock-launch %s %s\n' \
			"$ricon" "$rname" "$rinst" "$rexec" >> "$tmp"
	done <<EOF_RUN
$runlist
EOF_RUN
	$SUDO cp "$tmp" "$TCEWBAR"
	rm -f "$tmp"
	$SUDO chown root:staff "$TCEWBAR"
	# absolute mode, not g+w: the mktemp 0600 + g+w is 0620, and wbar and
	# xxri-wctl (group staff) can't read it - an invisible dock, no warning
	$SUDO chmod 664 "$TCEWBAR"
	log "write_dock: $n pinned + $r running app(s) written to $TCEWBAR"
	return 0
}

# rebuild, then restart wbar and the indicator daemon (both read tce.icons
# only at startup)
regen() {
	write_dock || return 1
	if [ -n "${DISPLAY:-}" ]; then
		wbar.sh >/dev/null 2>&1
		# Wait for the old daemon to be gone: it holds the root Button3 grab,
		# and a new one started too early silently gets BadAccess (no dock
		# right-click until the next rebuild). The [ ] stops pkill matching
		# its own command line.
		pkill -f 'xxri-wctl[ ]indicators' 2>/dev/null
		_i=0
		while pgrep -f 'xxri-wctl[ ]indicators' >/dev/null 2>&1 && [ "$_i" -lt 30 ]; do
			sleep 0.1
			_i=$((_i + 1))
		done
		( /usr/local/bin/xxri-wctl indicators & ) >/dev/null 2>&1
	fi
	return 0
}

cmd_pin() {
	id="${1:?usage: xxri-dock-pin pin ID}"
	ensure_pinned_file
	[ -f "$APPDIR/$id.desktop" ] || { log "pin $id: no such .desktop"; echo "no such application: $id" >&2; return 1; }
	if is_pinned "$id"; then log "pin $id: already pinned"; return 0; fi
	count=$(pinned_ids | wc -l)
	if [ "$count" -ge "$MAXPIN" ]; then log "pin $id: dock is full ($count/$MAXPIN)"; return 2; fi
	$SUDO sh -c "printf '%s\n' '$id' >> '$PINNED'"
	$SUDO chmod 644 "$PINNED"
	regen
}

cmd_unpin() {
	id="${1:?usage: xxri-dock-pin unpin ID}"
	ensure_pinned_file
	is_pinned "$id" || { log "unpin $id: not pinned"; return 1; }
	tmp=$(mktemp)
	grep -vx "$id" "$PINNED" > "$tmp"
	put_pinned "$tmp"
	rm -f "$tmp"
	regen
}

# Follows the open windows for the running section (from .xsession). Cheap
# check every second (the set of WM_CLASS names); only when it moves is the
# expensive window->app resolution run, and only when that changes is the
# dock rebuilt - opening a pinned app doesn't restart wbar.
cmd_watch() {
	wins=""; section=""
	while :; do
		now=$([ -n "${DISPLAY:-}" ] && [ -x "$WCTL" ] &&
		      "$WCTL" list 2>/dev/null | awk '{print $3}' | sort -u | tr '\n' ' ')
		if [ "$now" != "$wins" ]; then
			wins="$now"
			sect=$(running_entries)
			if [ "$sect" != "$section" ]; then
				section="$sect"
				log "watch: running section changed -> [$(echo "$sect" | tr '\n' ';')]"
				regen
			fi
		fi
		sleep "${XXRI_DOCK_WATCH_INTERVAL:-1}"
	done
}

trap 'rm -f "$IDX"' EXIT INT TERM HUP

case "${1:-}" in
	pin)   cmd_pin "${2:-}" ;;
	unpin) cmd_unpin "${2:-}" ;;
	list)  ensure_pinned_file; pinned_ids ;;
	count) ensure_pinned_file; pinned_ids | wc -l ;;
	running) running_entries ;;
	regen) regen ;;
	boot)  write_dock ;;
	watch) cmd_watch ;;
	*) echo "usage: xxri-dock-pin pin|unpin ID | list | count | running | regen | boot | watch" >&2; exit 2 ;;
esac
