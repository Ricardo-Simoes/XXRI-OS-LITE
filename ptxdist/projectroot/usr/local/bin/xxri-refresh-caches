#!/bin/sh
# xxri-refresh-caches - rebuild gdk-pixbuf's loaders.cache, the icon caches
# and the desktop database.
#
# Run by xxri-app after the Store loads an extension, which can bring new
# pixbuf loaders and icons (at boot each extension's install script does
# this). A stale loaders.cache leaves SVG and most PNG icons undecodable.

PB_DIR=""
for d in /usr/local/lib/gdk-pixbuf-2.0/2.10.0 /usr/lib/gdk-pixbuf-2.0/2.10.0; do
	[ -d "$d/loaders" ] && { PB_DIR="$d"; break; }
done

if [ -n "$PB_DIR" ] && command -v gdk-pixbuf-query-loaders >/dev/null 2>&1; then
	# regenerate when missing, empty, or older than the loaders directory
	if [ ! -s "$PB_DIR/loaders.cache" ] || [ "$PB_DIR/loaders" -nt "$PB_DIR/loaders.cache" ]; then
		tmp="$(mktemp 2>/dev/null || echo /tmp/.pbcache.$$)"
		if GDK_PIXBUF_MODULEDIR="$PB_DIR/loaders" gdk-pixbuf-query-loaders > "$tmp" 2>/dev/null &&
		   [ -s "$tmp" ]; then
			sudo cp -f "$tmp" "$PB_DIR/loaders.cache" 2>/dev/null
		fi
		rm -f "$tmp"
	fi
fi

# without icon-theme.cache GTK walks the whole tree on every lookup
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	for th in /usr/local/share/icons/*/; do
		[ -f "$th/index.theme" ] || continue
		[ -f "$th/icon-theme.cache" ] && [ "$th/icon-theme.cache" -nt "$th/index.theme" ] && continue
		sudo gtk-update-icon-cache -q -f -t "$th" >/dev/null 2>&1
	done
fi

# so newly installed apps are found by name
command -v update-desktop-database >/dev/null 2>&1 &&
	sudo update-desktop-database /usr/local/share/applications >/dev/null 2>&1

exit 0
