# Read by /usr/local/lib/xorg/Xorg.wrap (setuid root).  XXRI starts X from
# the autologin shell, not from a console VT, so the wrapper's default
# (console users only) would refuse it; and without logind the server needs
# root to become DRM master and to take over the VT.  Tiny Core's X.Org ran
# the same way.
allowed_users=anybody
needs_root_rights=yes
