iwlwifi-6050-5.ucode
#   Centrino Advanced-N 6205; Advanced-N 6230/6235, Wireless-N 1030
iwlwifi-6000g2a-6.ucode
iwlwifi-6000g2b-6.ucode
#   Centrino Wireless-N 2200/2230, 105, 135
iwlwifi-2000-6.ucode
